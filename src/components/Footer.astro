---
// About / footer — design: statement + 3 link columns + legal row.
const cols = [
  {
    title: 'Explore',
    links: [
      { label: 'Apps store', href: '/#apps' },
      { label: 'Bookstore', href: '/books/' },
      { label: 'Talks & conferences', href: '/talks/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Scrum Programming', href: '/apps/scrum-programming/' },
    ],
  },
  {
    title: 'Music',
    links: [
      { label: 'The Artist', href: '/artist/' },
      { label: 'mITyStudio', href: '/apps/mitystudio/' },
      { label: 'SoundCloud', href: 'https://soundcloud.com/mityjohn' },
      { label: 'Spotify', href: 'https://open.spotify.com/artist/4lRudVkciTQ8j2bEySXqPz' },
    ],
  },
  {
    title: 'Connect',
    links: [
      { label: 'Instagram', href: 'https://www.instagram.com/mity.john/' },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/in/jan-van-wassenhove-9b49893/' },
      { label: 'Twitter', href: 'https://twitter.com/mity_john' },
      { label: 'RSS', href: '/rss.xml' },
    ],
  },
];
const year = new Date().getFullYear();

// The two places to find Jan, as icon buttons in the legal row. Line glyphs
// on a 24px grid in currentColor, so they take the site's colours and hover
// rather than each network's own. The name is on the link (aria-label, title);
// the drawing itself is decorative.
const socials = [
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/jan-van-wassenhove-9b49893/',
    icon:
      '<rect x="3" y="3" width="18" height="18" rx="3.5"/><path d="M8 11v6M12 17v-3.6c0-1.4 1.1-2.4 2.5-2.4S17 12 17 13.4V17M12 11v6"/>' +
      '<circle cx="8" cy="7.6" r="1.1" fill="currentColor" stroke="none"/>',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/mity.john/',
    icon:
      '<rect x="3" y="3" width="18" height="18" rx="5.5"/><circle cx="12" cy="12" r="4.2"/>' +
      '<circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>',
  },
];
---

<footer id="about">
  <div class="grid">
    <div class="statement">
      <div class="kicker">// about mITy.John</div>
      <p>
        Jan Van Wassenhove — architect, tinkerer, and self-appointed
        <span class="hl">IT archeologist</span>. He digs up how we used to build software,
        then uses it as an excuse to build far too many things.
        <span class="aside">And now you know.</span>
      </p>
      <a class="more" href="/about/">Read the full story →</a>
    </div>
    {cols.map((col) => (
      <div>
        <div class="col-title">{col.title}</div>
        <div class="col-links">
          {col.links.map((l) => (
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="legal">
    <span>© {year} miTy John — the IT archeologist</span>
    <div class="legal-end">
      <span>Enforce innovation by learning from our development history.</span>
      <div class="socials">
        {socials.map((s) => (
          <a class="social" href={s.href} target="_blank" rel="noopener me" aria-label={`${s.label} — Jan Van Wassenhove`} title={s.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><Fragment set:html={s.icon} /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--line); background: var(--bg2); }
  .grid {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: clamp(44px, 6vw, 80px) var(--section-pad-x) 40px;
    display: grid;
    /* Fixed three columns so the link lists spread across the full width. An
       auto-fit track count left a trailing empty column on the right, because
       the full-width statement above keeps auto-fit from collapsing it. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
  }
  .statement { grid-column: 1 / -1; max-width: 640px; }
  @media (max-width: 720px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 460px) { .grid { grid-template-columns: 1fr; } }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--accent);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .statement p {
    font-family: var(--font-display);
    font-size: var(--text-statement);
    font-weight: 500;
    line-height: 1.35;
    margin: 0;
    letter-spacing: -0.01em;
    text-wrap: pretty;
    color: var(--text);
  }
  .hl { color: var(--accent); }
  .aside { color: var(--muted2); }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    padding: 11px 18px;
    border: 1px solid var(--border2);
    border-radius: var(--radius-btn);
  }
  .more:hover { border-color: var(--border3); }
  /* small square buttons at the end of the legal row */
  .social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: var(--muted);
    border: 1px solid var(--border2);
    border-radius: var(--radius-btn);
    transition: color var(--hover-duration) var(--hover-ease), border-color var(--hover-duration) var(--hover-ease);
  }
  .social:hover { color: var(--accent); border-color: var(--accent); }
  .social svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .col-title {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--muted2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
  }
  .col-links { display: flex; flex-direction: column; gap: 10px; }
  .col-links a { font-size: var(--text-body); color: var(--muted); }
  .col-links a:hover { color: var(--text); }
  .legal {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 20px var(--section-pad-x) 44px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .legal-end { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .socials { display: flex; gap: 8px; }
  /* design: --faint — raised to --muted2 for WCAG contrast (N5 a11y gate) */
  .legal span { font-family: var(--font-mono); font-size: var(--text-caption); color: var(--muted2); }
</style>
