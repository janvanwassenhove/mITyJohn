---
// Bookstore card — typographic 2/3 cover + description + Buy/Preview CTAs (design verbatim).
import type { CollectionEntry } from 'astro:content';

interface Props { book: CollectionEntry<'books'> }
const { book } = Astro.props;
const { title, series, badge, desc, buy, releases, preview, cover, isNew } = book.data;

// A book can be announced, with a preview, before it is on sale. Everything that
// would point at a shop is then left out rather than rendered dead.
const Cover = buy ? 'a' : 'div';
---

<div class="book" data-reveal>
  <Cover
    class={`cover${cover ? ' has-art' : ''}`}
    href={buy}
    target={buy ? '_blank' : undefined}
    rel={buy ? 'noopener' : undefined}
  >
    {/* A book that cannot be bought yet is not "new" — it is announced. The flag
        says which, so the card never promises something the shop cannot deliver. */}
    {!buy && releases
      ? <span class="new-flag soon-flag">IN THE OVEN</span>
      : isNew && <span class="new-flag">NEW</span>}
    {cover ? (
      <img src={cover} alt={`Cover of ${title}`} loading="lazy" decoding="async" width="600" height="948" />
    ) : (
      <div class="inner">
        <div class="series">{series}</div>
        <div>
          <div class="title">{title}</div>
          <div class="badge">{badge}</div>
        </div>
      </div>
    )}
  </Cover>
  <div class="meta">
    <div class="name">{title}</div>
    <p>{desc}</p>
    <div class="ctas">
      {buy
        ? <a class="buy" href={buy} target="_blank" rel="noopener">Buy on Amazon</a>
        : releases && <span class="soon">Out {releases}</span>}
      {preview && (
        preview.endsWith('.pdf') ? (
          /* Read in a lightbox rather than downloading the file. data-pdf-poster is
             WordPress's render of the first page, used where PDF iframes don't work. */
          <button
            class="preview"
            type="button"
            data-pdf={preview}
            data-pdf-title={title}
            data-pdf-poster={preview.replace(/\.pdf$/, '-pdf-1024x658.jpg')}
            data-pdf-buy={buy}
          >Preview</button>
        ) : (
          <a
            class="preview"
            href={preview}
            target={preview.startsWith('http') ? '_blank' : undefined}
            rel={preview.startsWith('http') ? 'noopener' : undefined}
          >Preview</a>
        )
      )}
    </div>
  </div>
</div>

<style>
  .book { display: flex; flex-direction: column; }
  .cover {
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-cover);
    overflow: hidden;
    border: 1px solid var(--border);
    background: repeating-linear-gradient(160deg, #1b1815 0 14px, #171410 14px 28px);
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  :root[data-theme='light'] .cover { background: repeating-linear-gradient(160deg, #e9e3d4 0 14px, #efeadd 14px 28px); }
  .cover:hover { border-color: var(--accent-2); transform: scale(1.025); }
  /* Real cover art: fill the 2/3 card, no typographic overlay */
  .cover.has-art { background: none; }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* top-right corner flag, same treatment as the store cards */
  .new-flag {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--ink-on-accent-2);
    background: var(--accent-2);
    border-radius: var(--radius-pill);
    padding: 3px 9px;
    box-shadow: 0 4px 14px -4px var(--accent-2);
  }
  /* Announced, not released: a quieter flag than NEW (declared after .new-flag so it wins), in the level colour rather
     than the accent, so a shelf of coming titles does not shout over the ones
     you can actually buy. */
  .soon-flag {
    color: var(--ink-on-level-books);
    background: var(--level-books);
  }
  .inner { position: absolute; inset: 0; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; }
  .series {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted2);
  }
  .title {
    font-family: var(--font-display);
    font-size: 21px;
    font-weight: 700;
    line-height: 1.08;
    color: var(--text);
    margin-bottom: 8px;
    text-wrap: balance;
  }
  .badge { font-family: var(--font-mono); font-size: var(--text-caption-xs); color: var(--accent-2); }
  .meta { margin-top: 14px; }
  .name { font-family: var(--font-display); font-size: var(--text-card-title-xs); font-weight: 600; margin-bottom: 5px; }
  p { font-size: var(--text-small); line-height: var(--leading-body); color: var(--muted2); margin: 0 0 12px; text-wrap: pretty; }
  .ctas { display: flex; gap: 8px; }
  /* Stands where the Buy button would be, so an announced book keeps the row's
     shape instead of leaving a gap next to Preview. */
  .soon {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    border: 1px dashed var(--border3);
    border-radius: var(--radius-btn-sm);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--accent-2);
    white-space: nowrap;
  }
  .buy {
    flex: 1;
    text-align: center;
    padding: 9px 12px;
    background: var(--accent-2);
    color: var(--ink-on-accent-2);
    border-radius: var(--radius-btn-sm);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: 600;
  }
  .buy:hover { filter: brightness(1.08); color: var(--ink-on-accent-2); }
  .preview {
    padding: 9px 12px;
    border: 1px solid var(--border2);
    border-radius: var(--radius-btn-sm);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--text);
    background: transparent;
    cursor: pointer;
  }
  .preview:hover { border-color: var(--border3); }
</style>
