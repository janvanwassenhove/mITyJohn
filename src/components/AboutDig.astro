---
// About-page flourish: an archaeologist in a cave, pickaxe swinging, unearthing
// recognisable retro-IT relics that glint like unearthed gems. Pure CSS motion,
// aria-hidden, frozen to a static tableau under reduced-motion.
// Box-shadow pixel art (same technique as ArcadeStrip). Every sprite here was
// rasterised to PNG and looked at before shipping, rather than plotted blind.

const put = (cells: [number, number, string][]) =>
  cells.map(([x, y, c]) => `${x * 6}px ${y * 6}px 0 ${c}`).join(', ');
function grid(x0: number, x1: number, y0: number, y1: number, c: string): [number, number, string][] {
  const out: [number, number, string][] = [];
  for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) out.push([x, y, c]);
  return out;
}

// Fedora archaeologist, both hands on a pickaxe angled down into the dirt.
const DIGGER = put([
  ...grid(3, 8, 0, 0, '#6b4a2a'), [4, -1, '#7d5732'], [5, -1, '#7d5732'], [6, -1, '#7d5732'], [7, -1, '#7d5732'],
  ...grid(4, 7, 1, 1, '#e8c39a'), [4, 2, '#e8c39a'], [5, 2, '#e8c39a'], [6, 2, '#17140f'], [7, 2, '#e8c39a'],
  ...grid(3, 7, 3, 4, '#8a6b3f'),
  [4, 5, '#33302b'], [6, 5, '#33302b'], [4, 6, '#33302b'], [6, 6, '#33302b'], [3, 7, '#33302b'], [7, 7, '#33302b'],
  [8, 3, '#e8c39a'], [9, 4, '#e8c39a'],
  [10, 5, '#7d5732'], [11, 6, '#7d5732'], [12, 7, '#7d5732'], [11, 5, '#9a9a9a'], [13, 7, '#9a9a9a'], [13, 8, '#9a9a9a'],
]);

// 3.5" floppy: blue shell, silver shutter with slit, corner notch, cream label
// with a red stripe. 9x9 cells = 54x54px.
const FLOPPY = put([
  ...grid(0, 8, 0, 8, '#2f6d8c'), ...grid(0, 8, 0, 0, '#28607d'),
  [0, 0, '#17140f'], [1, 0, '#17140f'],
  ...grid(4, 7, 0, 2, '#c9d6dc'), ...grid(5, 6, 0, 2, '#8fa0a8'),
  ...grid(1, 7, 4, 8, '#efe9db'), ...grid(2, 6, 5, 5, '#c24a3a'), ...grid(2, 5, 7, 7, '#9aa2a8'),
]);

// Old desktop: CRT with a green cursor line, wide base with a 5.25" drive slot,
// detached keyboard. 11x9 cells = 66x54px.
const OLDPC = put([
  ...grid(1, 8, 0, 4, '#cfc7b1'), ...grid(2, 7, 1, 3, '#22414d'),
  ...grid(3, 6, 2, 2, '#3f7f6d'), [3, 3, '#7fd0b0'],
  ...grid(0, 10, 5, 7, '#bcb298'), ...grid(2, 8, 6, 6, '#2b2b2b'),
  ...grid(3, 7, 8, 8, '#a89e86'),
]);

// Punch card: clipped corner, header row and columns of rectangular holes.
// 14x7 cells = 84x42px.
const PUNCH = (() => {
  const c: [number, number, string][] = [...grid(0, 13, 0, 6, '#efe9db')];
  c.push([0, 0, '#17140f'], [1, 0, '#17140f'], [0, 1, '#17140f']);
  const pattern = [2, 3, 4, 2, 5, 3, 4, 2, 3, 5, 4, 3];
  for (let i = 0; i < pattern.length; i++) {
    const x = 1 + i;
    if (x > 12) break;
    if (i % 2 === 0) c.push([x, pattern[i], '#2b2b2b']);
  }
  for (let x = 2; x <= 12; x += 2) c.push([x, 1, '#2b2b2b']);
  return put(c);
})();

// Ground line sits 116px down the 150px stage; top = 116 − sprite height.
const relics = [
  { art: FLOPPY, left: '42%', top: 62, w: 54, delay: '0s' },
  { art: OLDPC, left: '60%', top: 62, w: 66, delay: '1.6s' },
  { art: PUNCH, left: '78%', top: 74, w: 84, delay: '3.2s' },
];
const stalactites = [[9, 20, 32], [20, 13, 20], [33, 24, 42], [47, 15, 24], [62, 19, 30], [74, 28, 48], [87, 15, 22]];
const stalagmites = [[16, 15, 13], [69, 18, 17], [91, 13, 11]];
---

<div class="dig" aria-hidden="true">
  <div class="ceiling"></div>
  {stalactites.map(([l, w, h]) => (
    <span class="stal" style={`left:${l}%; width:${w}px; height:${h}px`}></span>
  ))}
  <span class="dig-label">// the dig — unearthing how we used to build software</span>
  {relics.map((r) => (
    <div
      class="relic"
      style={`left:${r.left}; top:${r.top}px; --sx:${r.w - 10}px; box-shadow:${r.art}; animation-delay:${r.delay}`}
    ></div>
  ))}
  <div class="soil"></div>
  {stalagmites.map(([l, w, h]) => (
    <span class="stalg" style={`left:${l}%; width:${w}px; height:${h}px`}></span>
  ))}
  <div class="ground"></div>
  <div class="digger" style={`box-shadow:${DIGGER}`}></div>
  <span class="dirt d1"></span>
  <span class="dirt d2"></span>
  <span class="dirt d3"></span>
</div>

<style>
  /* Always dark — a cave reads the same in both themes, like the arcade strips. */
  .dig {
    position: relative;
    height: 150px;
    margin: 0 0 clamp(28px, 4vw, 44px);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background:
      radial-gradient(60% 90% at 14% 32%, rgba(224, 164, 74, 0.2), transparent 60%),
      linear-gradient(180deg, #2a2219, #201a13 60%, #15110c);
  }
  .ceiling { position: absolute; inset: 0 0 auto 0; height: 15px; background: #332a1f; z-index: 1; }
  .stal {
    position: absolute; top: 0; z-index: 1;
    background: #3d3325;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .dig-label {
    position: absolute; top: 26px; left: 14px; z-index: 4;
    font-family: var(--font-mono);
    font-size: var(--text-caption-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a8f78;
  }
  .soil { position: absolute; left: 0; right: 0; bottom: 0; height: 34px; z-index: 2; background: #1d1913; }
  .stalg {
    position: absolute; bottom: 34px; z-index: 2;
    background: #2c2419;
    clip-path: polygon(50% 0, 0 100%, 100% 100%);
  }
  .ground { position: absolute; left: 0; right: 0; bottom: 34px; height: 2px; z-index: 2; background: #4a3f30; }

  .digger, .relic { position: absolute; width: 6px; height: 6px; }
  .relic { z-index: 1; opacity: 0; animation: surface 4.8s ease-in-out infinite; }

  /* Gem glints: two four-point stars per relic, twinkling while it is surfaced. */
  .relic::before,
  .relic::after {
    content: '';
    position: absolute;
    width: 10px; height: 10px;
    background: #fff6e0;
    opacity: 0;
    clip-path: polygon(50% 0%, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0% 50%, 40% 40%);
    animation: inherit;
    animation-name: glint-a;
  }
  .relic::before { left: -6px; top: 4px; }
  .relic::after { left: var(--sx); top: -6px; animation-name: glint-b; }

  .dirt {
    position: absolute;
    left: calc(16% + 74px);
    bottom: 32px;
    z-index: 3;
    width: 4px; height: 4px;
    border-radius: 1px;
    background: #8a6b3f;
    opacity: 0;
    animation: dirt-fly 0.72s ease-out infinite;
  }
  .dirt.d2 { left: calc(16% + 84px); animation-delay: 0.06s; background: #6b4a2a; }
  .dirt.d3 { left: calc(16% + 66px); animation-delay: 0.12s; }

  .digger {
    left: 16%;
    top: 68px; /* feet land on the 116px groundline; the pick bites below it */
    z-index: 3;
    transform-origin: 30px 48px;
    animation: dig-swing 0.72s ease-in-out infinite;
  }

  @keyframes dig-swing {
    0%, 100% { transform: rotate(-9deg); }
    45%, 62% { transform: rotate(3deg); }
  }
  @keyframes dirt-fly {
    0%, 45% { opacity: 0; transform: translate(0, 0); }
    60% { opacity: 1; transform: translate(7px, -12px); }
    100% { opacity: 0; transform: translate(13px, 2px); }
  }
  @keyframes surface {
    0%, 8% { opacity: 0; transform: translateY(26px); }
    20%, 80% { opacity: 1; transform: translateY(0); }
    92%, 100% { opacity: 0; transform: translateY(26px); }
  }
  /* glints fire inside the surfaced window (20%–80% of the cycle) */
  @keyframes glint-a {
    0%, 26% { opacity: 0; transform: scale(0) rotate(0deg); }
    33% { opacity: 1; transform: scale(1) rotate(45deg); }
    42%, 100% { opacity: 0; transform: scale(0) rotate(90deg); }
  }
  @keyframes glint-b {
    0%, 52% { opacity: 0; transform: scale(0) rotate(0deg); }
    60% { opacity: 1; transform: scale(1) rotate(45deg); }
    70%, 100% { opacity: 0; transform: scale(0) rotate(90deg); }
  }

  @media (max-width: 560px) {
    .dig { height: 132px; }
    .relic:last-of-type { display: none; }
    .stal:nth-child(odd) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .digger { animation: none; transform: rotate(-4deg); }
    .dirt { display: none; }
    .relic { animation: none; opacity: 1; transform: none; }
    .relic::before, .relic::after { animation: none; opacity: 0.9; transform: scale(1); }
  }
</style>
