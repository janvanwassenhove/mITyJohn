---
// About-page flourish: the archaeologist digging up retro-IT relics. Pure-CSS
// motion, aria-hidden, frozen into a static tableau under reduced-motion.
// Box-shadow pixel art on single elements, same technique as ArcadeStrip. Sprites
// draw DOWNWARD from their element's top-left, so everything is positioned by
// `top` = groundline − sprite height, and a soil band occludes relics until they
// clear the surface.
import { ARCHEOLOGIST } from './sprites';

const put = (cells: [number, number, string][]) =>
  cells.map(([x, y, c]) => `${x * 6}px ${y * 6}px 0 ${c}`).join(', ');

function grid(x0: number, x1: number, y0: number, y1: number, c: string): [number, number, string][] {
  const out: [number, number, string][] = [];
  for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) out.push([x, y, c]);
  return out;
}

// Floppy disk — body, metal shutter, label. Cells y0..5.
const FLOPPY = put([
  ...grid(0, 5, 0, 5, '#2f6d8c'),
  [3, 0, '#1c4a61'], [4, 0, '#1c4a61'], [5, 0, '#1c4a61'],
  [1, 0, '#c9d6dc'], [1, 1, '#c9d6dc'], [2, 1, '#1c4a61'],
  ...grid(1, 4, 3, 4, '#e9e2d1'),
]);
// Beige CRT — case, screen, base. Cells y0..4.
const CRT = put([
  ...grid(0, 5, 0, 3, '#d8cdb4'),
  ...grid(1, 4, 1, 2, '#2e5b4f'),
  [2, 1, '#4f8f7c'], [3, 1, '#4f8f7c'],
  ...grid(1, 4, 4, 4, '#c2b795'),
]);
// Microchip — dark body with gold pins. Cells y1..3.
const CHIP = put([
  ...grid(1, 4, 1, 3, '#26221c'),
  [2, 1, '#e0a44a'], [3, 1, '#e0a44a'],
  [0, 1, '#b7b7b7'], [0, 2, '#b7b7b7'], [5, 1, '#b7b7b7'], [5, 2, '#b7b7b7'],
]);

// Ground sits at bottom:34px → 116px from the top of a 150px stage. Each relic
// is topped so its lowest pixel lands on that line (top = 116 − pixelHeight).
const relics = [
  { art: FLOPPY, left: '45%', top: 80, delay: '0s' },   // 36px tall
  { art: CRT, left: '63%', top: 86, delay: '1.6s' },    // 30px tall
  { art: CHIP, left: '80%', top: 92, delay: '3.2s' },   // 24px tall
];
---

<div class="dig" aria-hidden="true">
  <span class="dig-label">// the dig — unearthing how we used to build software</span>
  {relics.map((r) => (
    <div class="relic" style={`left:${r.left}; top:${r.top}px; box-shadow:${r.art}; animation-delay:${r.delay}`}></div>
  ))}
  <div class="soil"></div>
  <div class="ground"></div>
  <div class="digger" style={`box-shadow:${ARCHEOLOGIST}`}></div>
  <span class="dirt d1"></span>
  <span class="dirt d2"></span>
  <span class="dirt d3"></span>
</div>

<style>
  .dig {
    position: relative;
    height: 150px;
    margin: 0 0 clamp(28px, 4vw, 44px);
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background:
      radial-gradient(120% 80% at 18% 130%, rgba(224, 164, 74, 0.07), transparent 60%),
      linear-gradient(180deg, var(--s1), var(--s0));
  }
  .dig-label {
    position: absolute;
    top: 12px;
    left: 14px;
    z-index: 4;
    font-family: var(--font-mono);
    font-size: var(--text-caption-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted2);
  }
  /* soil band: hides relics that are still below the surface */
  .soil {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 34px;
    z-index: 2;
    background: linear-gradient(180deg, #1d1913, #17130e);
  }
  .ground {
    position: absolute;
    left: 0; right: 0; bottom: 34px;
    height: 2px;
    z-index: 3;
    background: repeating-linear-gradient(90deg, var(--border3) 0 10px, transparent 10px 18px);
  }
  /* box-shadow sprites: a 6px origin cell, pixels hang down-right from it */
  .digger, .relic { position: absolute; width: 6px; height: 6px; }
  .relic { z-index: 1; opacity: 0; animation: surface 4.8s ease-in-out infinite; }
  .digger {
    left: 16%;
    top: 68px; /* feet (pixel y=48) land on the 116px groundline */
    z-index: 3;
    transform-origin: 24px 54px;
    animation: dig-bob 0.72s ease-in-out infinite;
  }
  /* dirt kicked up by the digger's feet, on the dig beat */
  .dirt {
    position: absolute;
    left: calc(16% + 30px);
    bottom: 34px;
    z-index: 3;
    width: 4px; height: 4px;
    border-radius: 1px;
    background: #8a6b3f;
    opacity: 0;
    animation: dirt-fly 0.72s ease-out infinite;
  }
  .dirt.d2 { left: calc(16% + 42px); animation-delay: 0.06s; background: #6b4a2a; }
  .dirt.d3 { left: calc(16% + 20px); animation-delay: 0.12s; }

  @keyframes dig-bob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    45%, 60% { transform: translateY(5px) rotate(5deg); }
  }
  @keyframes dirt-fly {
    0%, 45% { opacity: 0; transform: translate(0, 0); }
    60% { opacity: 1; transform: translate(6px, -13px); }
    100% { opacity: 0; transform: translate(12px, 1px); }
  }
  /* rise out of the soil, rest, sink back */
  @keyframes surface {
    0%, 8% { opacity: 0; transform: translateY(26px); }
    20%, 80% { opacity: 1; transform: translateY(0); }
    92%, 100% { opacity: 0; transform: translateY(26px); }
  }

  @media (max-width: 560px) {
    .dig { height: 132px; }
    .relic:last-of-type { display: none; } /* keep it uncrowded on phones */
  }
  @media (prefers-reduced-motion: reduce) {
    .digger { animation: none; }
    .dirt { display: none; }
    .relic { animation: none; opacity: 1; transform: none; }
  }
</style>
